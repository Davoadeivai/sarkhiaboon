# ---------------------------------------------------------------
# Sarkhiaboon backend configuration
# Copy to .env and fill in. Never commit the real .env file.
# ---------------------------------------------------------------

# --- Production server (deploy/docker-compose.prod.yml, docs/DEPLOY.md) ---
DOMAIN=api.example.ir
LETSENCRYPT_EMAIL=admin@example.ir
# Number of reverse proxies in front of Django (nginx = 1); 0 when none
TRUSTED_PROXY_COUNT=1
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=4
# PyPI mirror for building the image on an Iranian server, e.g. a local mirror
PIP_INDEX_URL=https://pypi.org/simple
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# --- Django ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.example.ir,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.ir
PUBLIC_BASE_URL=https://api.example.ir
LOG_LEVEL=INFO
# Set true if nginx does not already redirect HTTP to HTTPS
DJANGO_SECURE_SSL_REDIRECT=false
# Enable only after HTTPS works on the final domain (31536000 = 1 year)
DJANGO_HSTS_SECONDS=0

# --- PostgreSQL (leave POSTGRES_DB empty to use SQLite locally) ---
POSTGRES_DB=sarkhiaboon
POSTGRES_USER=sarkhiaboon
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- SMS / OTP ---
# Console backend prints the code to the server log (development only)
SMS_BACKEND=apps.accounts.sms.ConsoleSMSBackend
# SMS_BACKEND=apps.accounts.sms.KavenegarSMSBackend
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Virtual try-on engine ---
# Mock provider works without a GPU (development and demos of the flow)
TRYON_PROVIDER=apps.tryon.providers.mock.MockProvider
# TRYON_PROVIDER=apps.tryon.providers.runpod.RunPodProvider
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
TRYON_PROVIDER_TIMEOUT_SECONDS=180
TRYON_MAX_UPLOAD_MB=8
TRYON_MIN_WIDTH=384
TRYON_MIN_HEIGHT=512
TRYON_GUEST_DAILY_LIMIT=3
TRYON_USER_DAILY_LIMIT=30
TRYON_MIN_BRIGHTNESS=35
TRYON_MAX_BRIGHTNESS=235
# Blur check threshold; calibrate with real photos. 0 disables it.
TRYON_MIN_SHARPNESS=15
TRYON_MAX_RETRIES=2
TRYON_ENABLE_RESULT_CACHE=true
# Hours an uploaded person photo is kept. 0 = delete right after the try-on.
TRYON_PERSON_PHOTO_RETENTION_HOURS=24
# Optional PNG logo stamped on result images (absolute path inside the container)
TRYON_WATERMARK_IMAGE=

# --- Push notifications ---
# LogPushBackend writes them to the server log (development)
PUSH_BACKEND=apps.notifications.backends.LogPushBackend
# PUSH_BACKEND=apps.notifications.backends.ExpoPushBackend
# Optional: only if "enhanced push security" is enabled in the Expo account
EXPO_PUSH_ACCESS_TOKEN=

# --- Payments ---
PAYMENT_GATEWAY=apps.orders.gateways.SandboxGateway
# PAYMENT_GATEWAY=apps.orders.gateways.ZarinpalGateway
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=https://api.example.ir/api/v1/orders/payment/callback/
ORDER_PAYMENT_TIMEOUT_MINUTES=30
ORDER_SHIPPING_COST=0
ORDER_FREE_SHIPPING_OVER=0
ORDER_MAX_QUANTITY_PER_ITEM=10
PAYMENT_RESULT_URL=sarkhiaboon://payment/result
