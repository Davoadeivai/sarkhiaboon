# Rendered by the nginx image at start-up (envsubst): ${DOMAIN}, ${API_UPSTREAM},
# ${STATIC_ROOT}, ${MEDIA_ROOT}, ${CERT_DIR}, ${ACME_ROOT}.

upstream sarkhiaboon_api {
    server ${API_UPSTREAM};
    keepalive 16;
}

# Plain HTTP: only Let's Encrypt challenges; everything else goes to HTTPS.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root ${ACME_ROOT};
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     ${CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${CERT_DIR}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # Person photos can be up to TRYON_MAX_UPLOAD_MB (8 MB); leave headroom.
    client_max_body_size 12m;

    gzip on;
    gzip_types application/json text/css application/javascript image/svg+xml;
    gzip_min_length 1024;

    location /static/ {
        alias ${STATIC_ROOT}/;
        expires 30d;
        access_log off;
    }

    # Customers' own photos and try-on results: random names, never cached by
    # proxies or indexed, never listed.
    location /media/tryon/ {
        alias ${MEDIA_ROOT}/tryon/;
        autoindex off;
        add_header Cache-Control "private, no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Catalog images (products, banners, shop logos)
    location /media/ {
        alias ${MEDIA_ROOT}/;
        autoindex off;
        expires 7d;
        access_log off;
    }

    location / {
        proxy_pass http://sarkhiaboon_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
